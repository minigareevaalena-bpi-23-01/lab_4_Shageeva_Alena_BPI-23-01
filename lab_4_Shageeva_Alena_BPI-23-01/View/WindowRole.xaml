<Window x:Class="lab_4_Shageeva_Alena_BPI_23_01.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_4_Shageeva_Alena_BPI_23_01.View"
        mc:Ignorable="d"
        Title="Должности" Height="300" Width="800">
    <DockPanel Background="#FFD8D8D8">


        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="5">
            <Button Content="Добавить" Command="{Binding AddRole}" Margin="5" Width="100"/>
            <Button Content="Редактировать" Command="{Binding EditRole}" Margin="5" Width="100"/>
            <Button Content="Удалить" Command="{Binding DeleteRole}" Margin="5" Width="100"/>
        </StackPanel>


        <ListView ItemsSource="{Binding ListRole}" 
               SelectedItem="{Binding SelectedRole}" 
               Background="#FFD3CDCD" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Наименование должности" DisplayMemberBinding="{Binding NameRole}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
