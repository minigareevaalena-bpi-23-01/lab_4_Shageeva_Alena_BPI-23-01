<Window x:Class="lab_4_Shageeva_Alena_BPI_23_01.View.WindowEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_4_Shageeva_Alena_BPI_23_01.View"
        mc:Ignorable="d"
        Title="Сотрудники" Height="450" Width="700">

    <DockPanel Background="#FFD8D8D8">


        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="5">
            <Button Content="Добавить" Command="{Binding AddPerson}" Margin="5" Width="100"/>
            <Button Content="Редактировать" Command="{Binding EditPerson}" Margin="5" Width="100"/>
            <Button Content="Удалить" Command="{Binding DeletePerson}" Margin="5" Width="100"/>
        </StackPanel>


        <ListView ItemsSource="{Binding ListPersonDpo}"
              SelectedItem="{Binding SelectedPersonDpo}"
              Background="#FFD3CDCD" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Фамилия" Width="150" DisplayMemberBinding="{Binding LastName}"/>
                    <GridViewColumn Header="Имя" Width="150" DisplayMemberBinding="{Binding FirstName}"/>
                    <GridViewColumn Header="Должность" Width="150" DisplayMemberBinding="{Binding RoleName}"/>
                    <GridViewColumn Header="Дата рождения" Width="150" DisplayMemberBinding="{Binding Birthday}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>

</Window>
